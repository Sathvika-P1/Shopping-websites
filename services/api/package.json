{
  "name": "comp-storefront-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22" },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/migrate.js && node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "devloop": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
